<svg font-family="-apple-system-body, ui-sans-serif, -apple-system, system-ui, &quot;Segoe UI&quot;, Helvetica, &quot;Apple Color Emoji&quot;, Arial, sans-serif, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;" font-weight="400" data-d-component="svg" fill="currentColor" style="color:rgb(237, 237, 237)" viewBox="0 0 320 210" width="100%" xmlns="http://www.w3.org/2000/svg"><rect x="8" y="80" width="78" height="38" rx="7" fill="#2563eb"/><text x="47" y="103" font-size="12" fill="white" text-anchor="middle">Input X</text><path d="M86 99 H125" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="M119 94 L125 99 L119 104" stroke="currentColor" fill="none"/><rect x="125" y="80" width="105" height="38" rx="7" fill="#64748b"/><text x="177" y="103" font-size="12" fill="white" text-anchor="middle">Layer F(X)</text><path d="M230 99 H255 V130 H275" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="M269 125 L275 130 L269 135" stroke="currentColor" fill="none"/><path d="M47 118 V164 H275 V145" stroke="#16a34a" stroke-width="2" fill="none"/><path d="M269 151 L275 145 L281 151" stroke="#16a34a" stroke-width="2" fill="none"/><circle cx="275" cy="130" r="15" fill="#16a34a"/><text x="275" y="135" font-size="17" fill="white" text-anchor="middle">+</text><text x="160" y="190" font-size="12" fill="currentColor" text-anchor="middle">Y = F(X) + X</text></svg>