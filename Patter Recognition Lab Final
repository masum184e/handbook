n":0.310862,"end_time":"2026-08-05T05:07:06.381658+00:00","exception":false,"start_time":"2026-08-05T05:07:06.070796+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1600x400 with 4 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Visualize the preprocessing pipeline on one sample image\n","sample = resized_images[0]\n","sample_pp = preprocessed_data[0]\n","\n","fig, axes = plt.subplots(1, 4, figsize=(16, 4))\n","axes[0].imshow(cv2.cvtColor(sample, cv2.COLOR_BGR2RGB)); axes[0].set_title(\"Original (resized)\")\n","axes[1].imshow(cv2.cvtColor(sample_pp[\"bgr\"], cv2.COLOR_BGR2RGB)); axes[1].set_title(\"Denoised (Gaussian Blur)\")\n","axes[2].imshow(sample_pp[\"gray\"], cmap=\"gray\"); axes[2].set_title(\"Grayscale\")\n","axes[3].imshow(sample_pp[\"equalized\"], cmap=\"gray\"); axes[3].set_title(\"Histogram Equalized\")\n","for ax in axes:\n","    ax.axis(\"off\")\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"code","execution_count":25,"id":"59627611","metadata":{"execution":{"iopub.execute_input":"2026-08-05T05:07:06.447486Z","iopub.status.busy":"2026-08-05T05:07:06.447255Z","iopub.status.idle":"2026-08-05T05:07:06.451697Z","shell.execute_reply":"2026-08-05T05:07:06.451048Z"},"papermill":{"duration":0.038562,"end_time":"2026-08-05T05:07:06.452798+00:00","exception":false,"start_time":"2026-08-05T05:07:06.414236+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def extract_color_histogram(pp):\n","    \"\"\"2D Hue-Saturation histogram from the HSV image (16x16 bins).\"\"\"\n","    hist = cv2.calcHist([pp[\"hsv\"]], [0, 1], None, [16, 16], [0, 180, 0, 256])\n","    hist = cv2.normalize(hist, hist)\n","    return hist.flatten().astype(np.float32)"]},{"cell_type":"code","execution_count":26,"id":"4d964436","metadata":{"execution":{"iopub.execute_input":"2026-08-05T05:07:06.516362Z","iopub.status.busy":"2026-08-05T05:07:06.516116Z","iopub.status.idle":"2026-08-05T05:07:06.521206Z","shell.execute_reply":"2026-08-05T05:07:06.520596Z"},"papermill":{"duration":0.038158,"end_time":"2026-08-05T05:07:06.522715+00:00","exception":false,"start_time":"2026-08-05T05:07:06.484557+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def extract_glcm_features(pp):\n","    \"\"\"Mean & std of GLCM properties across multiple distances/angles, plus entropy.\"\"\"\n","    gray = cv2.resize(pp[\"gray\"], (128, 128))\n","    quantized = (gray / 32).astype(np.uint8)  # reduce 256 -> 8 gray levels\n","\n","    glcm = graycomatrix(\n","        quantized, distances=[1, 2],\n","        angles=[0, np.pi / 4, np.pi / 2, 3 * np.pi / 4],\n","        levels=8, symmetric=True, normed=True\n","    )\n","\n","    properties = [\"contrast\", \"dissimilarity\", \"homogeneity\", \"energy\", \"correlation\", \"ASM\"]\n","    features = []\n","    for prop in properties:\n","        values = graycoprops(glcm, prop)\n","        features.extend([values.mean(), values.std()])\n","\n","    entropy = -np.sum(glcm * np.log2(glcm + 1e-10))\n","    features.append(entropy)\n","\n","    return np.array(features, dtype=np.float32)\n"]},{"cell_type":"code","execution_count":27,"id":"43c80b60","metadata":{"execution":{"iopub.execute_input":"2026-08-05T05:07:06.586839Z","iopub.status.busy":"2026-08-05T05:07:06.586613Z","iopub.status.idle":"2026-08-05T05:07:06.590547Z","shell.execute_reply":"2026-08-05T05:07:06.58994Z"},"papermill":{"duration":0.037257,"end_time":"2026-08-05T05:07:06.59173+00:00","exception":false,"start_time":"2026-08-05T05:07:06.554473+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def extract_hog_features(pp):\n","    gray = cv2.resize(pp[\"gray\"], (64, 64))\n","    hog = cv2.HOGDescriptor((64, 64), (16, 16), (8, 8), (8, 8), 9)\n","    features = hog.compute(gray)\n","    return features.flatten().astype(np.float32)\n"]},{"cell_type":"code","execution_count":28,"id":"51135087","metadata":{"execution":{"iopub.execute_input":"2026-08-05T05:07:06.653826Z","iopub.status.busy":"2026-08-05T05:07:06.653597Z","iopub.status.idle":"2026-08-05T05:07:06.657933Z","shell.execute_reply":"2026-08-05T05:07:06.657377Z"},"papermill":{"duration":0.03681,"end_time":"2026-08-05T05:07:06.659389+00:00","exception":false,"start_time":"2026-08-05T05:07:06.622579+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["from skimage.feature import local_binary_pattern\n","\n","def extract_lbp_features(pp):\n","    \"\"\"Normalized uniform-LBP histogram.\"\"\"\n","    radius = 2\n","    points = 8 * radius\n","    lbp = local_binary_pattern(pp[\"gray\"], points, radius, method=\"uniform\")\n","    hist, _ = np.histogram(lbp.ravel(), bins=np.arange(0, points + 3), range=(0, points + 2))\n","    hist = hist.astype(np.float32)\n","    hist /= hist.sum() + 1e-7\n","    return hist"]},{"cell_type":"code","execution_count":29,"id":"40051e31","metadata":{"execution":{"iopub.execute_input":"2026-08-05T05:07:06.72263Z","iopub.status.busy":"2026-08-05T05:07:06.722391Z","iopub.status.idle":"2026-08-05T05:07:06.726432Z","shell.execute_reply":"2026-08-05T05:07:06.725822Z"},"papermill":{"duration":0.036885,"end_time":"2026-08-05T05:07:06.727509+00:00","exception":false,"start_time":"2026-08-05T05:07:06.690624+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def extract_edge_features(pp):\n","    \"\"\"Canny edge density and edge-contour count.\"\"\"\n","    edges = cv2.Canny(pp[\"gray\"], 100, 200)\n","    edge_density = np.count_nonzero(edges) / edges.size\n","    contours, _ = cv2.findContours(edges, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n","    return np.array([edge_density, len(contours)], dtype=np.float32)"]},{"cell_type":"code","execution_count":30,"id":"cf7a46c4","metadata":{"execution":{"iopub.execute_input":"2026-08-05T05:07:06.790102Z","iopub.status.busy":"2026-08-05T05:07:06.78982Z","iopub.status.idle":"2026-08-05T05:07:06.796331Z","shell.execute_reply":"2026-08-05T05:07:06.795443Z"},"papermill":{"duration":0.039476,"end_time":"2026-08-05T05:07:06.797589+00:00","exception":false,"start_time":"2026-08-05T05:07:06.758113+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def extract_shape_features(pp):\n","    \"\"\"Contour-based geometry: area, perimeter, aspect ratio, extent, solidity,\n","    circularity, equivalent diameter, and 7 Hu moments (13 features total).\"\"\"\n","    _, binary = cv2.threshold(pp[\"gray\"], 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n","    contours, _ = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n","\n","    if not contours:\n","        return np.zeros(13, dtype=np.float32)\n","\n","    contour = max(contours, key=cv2.contourArea)\n","    area = cv2.contourArea(contour)\n","    perimeter = cv2.arcLength(contour, True)\n","    x, y, w, h = cv2.boundingRect(contour)\n","    aspect_ratio = w / h if h > 0 else 0\n","    extent = area / (w * h) if (w * h) > 0 else 0\n","\n","    hull = cv2.convexHull(contour)\n","    hull_area = cv2.contourArea(hull)\n","    solidity = area / hull_area if hull_area > 0 else 0\n","    circularity = (4 * np.pi * area / (perimeter ** 2)) if perimeter > 0 else 0\n","    equiv_diameter = np.sqrt(4 * area / np.pi) if area > 0 else 0\n","\n","    moments = cv2.moments(contour)\n","    hu_moments = cv2.HuMoments(moments).flatten()\n","\n","    basic = [area, perimeter, aspect_ratio, extent, solidity, circularity, equiv_diameter]\n","    return np.array(basic + hu_moments.tolist(), dtype=np.float32)\n"]},{"cell_type":"code","execution_count":31,"id":"b455f998","metadata":{"execution":{"iopub.execute_input":"2026-08-05T05:07:06.8591Z","iopub.status.busy":"2026-08-05T05:07:06.858812Z","iopub.status.idle":"2026-08-05T05:07:06.90116Z","shell.execute_reply":"2026-08-05T05:07:06.9004Z"},"papermill":{"duration":0.074437,"end_time":"2026-08-05T05:07:06.902361+00:00","exception":false,"start_time":"2026-08-05T05:07:06.827924+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Color histogram : 256 features\n","GLCM             : 13 features\n","HOG               : 1764 features\n","LBP               : 18 features\n","Edge-based        : 2 features\n","Shape             : 14 features\n","----------------------------------------\n","Combined total    : 2067 features\n"]}],"source":["def extract_all_features(pp):\n","    color_feat = extract_color_histogram(pp)\n","    glcm_feat = extract_glcm_features(pp)\n","    hog_feat = extract_hog_features(pp)\n","    lbp_feat = extract_lbp_features(pp)\n","    edge_feat = extract_edge_features(pp)\n","    shape_feat = extract_shape_features(pp)\n","\n","    combined = np.concatenate([color_feat, glcm_feat, hog_feat, lbp_feat, edge_feat, shape_feat])\n","    return combined.astype(np.float32)\n","\n","\n","# Show individual feature-vector lengths for one sample\n","sample_pp = preprocessed_data[0]\n","print(\"Color histogram :\", extract_color_histogram(sample_pp).shape[0], \"features\")\n","print(\"GLCM             :\", extract_glcm_features(sample_pp).shape[0], \"features\")\n","print(\"HOG               :\", extract_hog_features(sample_pp).shape[0], \"features\")\n","print(\"LBP               :\", extract_lbp_features(sample_pp).shape[0], \"features\")\n","print(\"Edge-based        :\", extract_edge_features(sample_pp).shape[0], \"features\")\n","print(\"Shape             :\", extract_shape_features(sample_pp).shape[0], \"features\")\n","print(\"-\" * 40)\n","print(\"Combined total    :\", extract_all_features(sample_pp).shape[0], \"features\")"]},{"cell_type":"code","execution_count":32,"id":"9c56f4e0","metadata":{"execution":{"iopub.execute_input":"2026-08-05T05:07:06.963691Z","iopub.status.busy":"2026-08-05T05:07:06.963442Z","iopub.status.idle":"2026-08-05T05:07:15.676349Z","shell.execute_reply":"2026-08-05T05:07:15.67553Z"},"papermill":{"duration":8.745274,"end_time":"2026-08-05T05:07:15.677628+00:00","exception":false,"start_time":"2026-08-05T05:07:06.93235